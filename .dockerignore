# Build context for deploy/api.Dockerfile (context = repo root). Keeps the
# multi-GB DVC-tracked data/models and dev-only cruft out of the image build
# context — models/data are bind-mounted at runtime (deploy/docker-compose.yml),
# never baked in.
.git
.dvc/cache
.venv
data
models
frontend
node_modules
mlruns
outputs
logs
notebooks
tests
deploy/terraform
**/__pycache__
*.sqlite
.env
deploy/.env
# The real Basic Auth bcrypt hash (deploy/proxy.env.example is the tracked
# template and must stay excluded from this — an explicit filename, not a
# wildcard, so it can't accidentally catch *.env.example too).
deploy/proxy.env
# deploy.sh's box-local runtime state (rollback-target Caddyfile snapshot,
# flock lockfile) — not secrets, just not build input either.
deploy/proxy/Caddyfile.deployed
deploy/.deploy.lock
