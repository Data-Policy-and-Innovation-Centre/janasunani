# Copy to deploy/.env (gitignored) on the box and fill in.

# Postgres superuser password — same one embedded in the project .env's
# OLTP_DB_URL. Compose refuses to start oltp without it. Must be URL-safe
# (no ':', '@', '/', or '?') — it's interpolated straight into the api
# service's OLTP_DB_URL connection string in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Image tag to deploy — set by `IMAGE_TAG=<sha> bash deploy/deploy.sh` (CI
# writes this file's IMAGE_TAG= line automatically; only set it by hand for a
# manual/rollback run). Compose refuses to start api/frontend without it.
IMAGE_TAG=

# Public hostname — a nip.io name that resolves to the box's Elastic IP, so
# Caddy can obtain a real Let's Encrypt certificate with no DNS setup
# (deploy/proxy/Caddyfile). Leave unset only for a plain-HTTP local test
# (falls back to ":80", no TLS).
SITE_ADDRESS=52-66-116-80.nip.io

# Override the GHCR image repositories only if you're testing a fork/mirror;
# the defaults (deploy/docker-compose.yml) point at the private
# ghcr.io/data-policy-and-innovation-centre/janasunani-{api,frontend} images.
# API_IMAGE=
# FRONTEND_IMAGE=

# HTTP Basic Auth in front of the whole site (production grievance data,
# e.g. /history, must not be openly public — /api/health is the one
# exemption, see deploy/proxy/Caddyfile). DEMO_USER defaults to "demo" if
# left unset (the username isn't the secret); DEMO_PASSWORD_HASH has NO
# default — compose refuses to start the proxy without one set here. Generate
# a hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
DEMO_USER=
DEMO_PASSWORD_HASH=
