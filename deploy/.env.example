# Copy to deploy/.env (gitignored) on the box and fill in.

# Postgres superuser password — same one embedded in the project .env's
# OLTP_DB_URL. Compose refuses to start oltp without it. Must be URL-safe
# (no ':', '@', '/', or '?') — it's interpolated straight into the api
# service's OLTP_DB_URL connection string in docker-compose.yml. Also avoid
# '$' (Compose interpolates '$' in .env values — an unescaped '$' here can
# silently turn into an empty/wrong substitution) and '#' (Compose treats a bare '#' as starting a comment,
# truncating the rest of the line — quote the value, e.g.
# POSTGRES_PASSWORD='we#ird$pass', if you can't avoid either character).
POSTGRES_PASSWORD=change-me

# Image tag to deploy — set by `IMAGE_TAG=<sha> bash deploy/deploy.sh` (CI
# writes this file's IMAGE_TAG= line automatically; only set it by hand for a
# manual/rollback run). deploy/deploy.sh refuses to bring up the full stack
# without it (compose itself doesn't gate on this — see docker-compose.yml).
IMAGE_TAG=

# The box's hostname — a nip.io name that resolves to the box's Elastic IP, so
# Caddy can obtain a real Let's Encrypt certificate with no DNS setup
# (deploy/proxy/Caddyfile). Viewers use the CloudFront address instead
# (terraform output site_url); this name is CloudFront's origin. Leave unset only for a plain-HTTP local test
# (falls back to ":80", no TLS).
SITE_ADDRESS=52-66-116-80.nip.io

# Override the image repositories only if you're testing a fork/mirror; the
# defaults (deploy/docker-compose.yml) point at the project's ECR repositories
# 966452703664.dkr.ecr.ap-south-1.amazonaws.com/janasunani-{api,frontend}.
# API_IMAGE=
# FRONTEND_IMAGE=

# ORIGIN_VERIFY_SECRET is NOT in this file — it lives in deploy/proxy.env
# (copy deploy/proxy.env.example). The site's login is at the CloudFront edge
# (deploy/terraform/auth.tf), not on the box.
