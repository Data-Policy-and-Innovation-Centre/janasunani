# Copy to deploy/proxy.env (gitignored) and fill in DEMO_PASSWORD_HASH.
#
# Kept SEPARATE from deploy/.env on purpose: Docker Compose interpolates `$`
# in `environment:`/`.env` values, so a Caddy bcrypt hash like
# `$2a$14$abc...` pasted into deploy/.env gets mangled (`$2a`, `$14` parsed
# as compose variable references) and Caddy ends up with a broken hash. An
# `env_file` (this one) is injected into the container's environment
# verbatim -- no compose interpolation, no `$` escaping needed. Paste a real
# hash below exactly as `caddy hash-password` prints it.
#
# HTTP Basic Auth protects the whole site (deploy/proxy/Caddyfile) --
# production grievance data (/history, /api/history, /api/grievance/{id})
# must not be openly public. /api/health is the one exemption.
#
# DEMO_USER isn't the secret, so a real default is fine here.
DEMO_USER=demo

# NO default -- deploy/deploy.sh refuses to bring the stack up while this is
# empty or still says "change-me". Generate a real hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
DEMO_PASSWORD_HASH=
