# Copy to deploy/proxy.env (gitignored) and fill in ORIGIN_VERIFY_SECRET.
#
# The site's login is checked at the CloudFront edge (deploy/terraform/auth.tf).
# Caddy (deploy/proxy/Caddyfile) only forwards requests that carry this value
# in X-Origin-Verify, which only our CloudFront distribution adds. Everything
# else gets a 403, except /api/health.
#
# NO default. deploy/deploy.sh refuses to bring the stack up unless this is
# 32+ letters and digits. Copy it from Terraform:
#   terraform -chdir=deploy/terraform output -raw origin_verify_secret
#
# Kept apart from deploy/.env so it is loaded with `format: raw` and never
# interpolated by Compose.
ORIGIN_VERIFY_SECRET=
