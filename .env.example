# Copy to .env and fill in. Loaded by janasunani.config.Settings (pydantic-settings).
# All values have sane defaults except credentials; only override what you need.

# Environment: "local"/"dev" use local document storage; "main"/prod use S3.
ENV=local
DEBUG=True

# --- Janasunani complaint API (document ingestion source) ---
JANASUNANI_API_BASE_URL=https://janasunani.odisha.gov.in/api/DataServices
JANASUNANI_API_USERNAME=
JANASUNANI_API_PASSWORD=

# --- Complaint store (async SQLAlchemy) ---
# Defaults to sqlite at data/raw/grievance.db
# DB_URL=sqlite+aiosqlite:///data/raw/grievance.db
DB_PASSWORD=

# --- MySQL source for migration (cold-start dump restore or live sync) ---
# e.g. mysql+pymysql://user:pass@127.0.0.1:3306/sociomatics_ticket
MYSQL_URL=

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=janasunani-data-main
AWS_S3_DOCUMENTS=janasunani-documents-main
